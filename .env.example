# Names only. Copy to .env and fill in locally. .env is gitignored and dockerignored.
# Never paste real values into chats, docs or commits.

# Hostinger AI Router (OpenAI-compatible, 150+ models, one key)
AI_ROUTER_BASE_URL=https://router.hostinger.com/v1
AI_ROUTER_API_KEY=

# Core behaviour: "stub" (no keys, deterministic) or "live" (real model calls)
CORE_MODE=stub
# Comma-separated model IDs, verified against GET /v1/models before use
CORE_MODELS=

# Few-shot examples: "retrieval" (anchors + nearest dev examples, default) or "static"
# (anchors only). RETRIEVAL_K = nearest dev examples per text, 0-12 (default 4).
FEWSHOT_MODE=
RETRIEVAL_K=

# Local SQLite database
DB_PATH=data/app.db

# Daily challenge job (names only; empty means the built-in default)
DAILY_JOB_ENABLED=
DAILY_JOB_HOUR=
DAILY_JOB_MINUTE=
DAILY_TZ=
DAILY_TZ_FALLBACK_OFFSET_MINUTES=
DAILY_MAX_CLUSTERS=
DAILY_MAX_PER_CLUSTER=
DAILY_MAX_HEADLINES=
DAILY_LINEUP_POOL=

# Analyze spend protection: successful analyses per local day (DAILY_TZ); empty = 500, 0 = unlimited
ANALYZE_DAILY_CAP=

# Hostinger VPS (production host)
VPS_HOST=31.220.55.73
VPS_USER=deploy
VPS_SSH_KEY_PATH=~/.ssh/id_ed25519

# Public domain served by Traefik on the VPS, plus the VPS host name kept for older links
PUBLIC_DOMAIN=iamnotbrainwashed.tech
LEGACY_DOMAIN=srv2160832.hstgr.cloud